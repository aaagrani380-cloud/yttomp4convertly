PORT=8787
FRONTEND_ORIGIN=https://YOUR-SITE.netlify.app,http://127.0.0.1:5500
REDIS_URL=redis://redis:6379

# Supabase is used only for auth, accounts, quotas, history and analytics.
# Converted media is NOT uploaded to Supabase Storage.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# Ephemeral media delivery: the finished file exists only temporarily on the backend.
TEMP_DIR=/tmp/convertly
EPHEMERAL_OUTPUT_DIR=/tmp/convertly/downloads
DOWNLOAD_TTL_MINUTES=30
CLEANUP_BATCH=100

FREE_DAILY_CONVERSIONS=5
PRO_DAILY_CONVERSIONS=20
ADMIN_DAILY_CONVERSIONS=20
FREE_DAILY_HIGH_QUALITY=0
PRO_DAILY_HIGH_QUALITY=20
ADMIN_DAILY_HIGH_QUALITY=20
FREE_MAX_ACTIVE_JOBS=1
PRO_MAX_ACTIVE_JOBS=2
ADMIN_MAX_ACTIVE_JOBS=4
FREE_MAX_DURATION_SECONDS=1800
PRO_MAX_DURATION_SECONDS=9000
ADMIN_MAX_DURATION_SECONDS=14400
CONVERSION_REQUESTS_PER_HOUR=20
WORKER_CONCURRENCY=1
MP3_BITRATE=192K
YTDLP_BIN=yt-dlp
ALLOW_GUEST_CONVERSION=false
LOCAL_TEST_STORAGE=true
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TARGET_SIZE_PRESET=veryfast
FORCE_COMPATIBLE_MP4=true
COMPATIBILITY_PRESET=veryfast
COMPATIBILITY_CRF=18
COMPATIBILITY_AUDIO_BITRATE=192k
